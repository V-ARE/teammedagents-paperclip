{
  "name": "@teammedagents-paperclip/core",
  "version": "0.0.2",
  "type": "module",
  "description": "Pure TypeScript runtime for TeamMedAgents workflow and teamwork orchestration",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/**/*.test.js",
    "dev": "tsc --watch"
  },
  "keywords": [
    "teammedagents",
    "orchestration",
    "multi-agent",
    "medical-reasoning"
  ],
  "author": "TeamMedAgents Team",
  "license": "MIT",
  "dependencies": {
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "dotenv": "^17.4.2",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5"
  }
}