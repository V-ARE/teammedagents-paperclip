# TeamMedAgents API Keys
# You only need to provide the keys for the providers you intend to use for the CLI testing.
# When running as a Paperclip adapter, users will input these via the UI.

# Google AI Studio Models
GOOGLE_API_KEY=your-api-key-here
# Alternatively:
# GEMINI_API_KEY=your-api-key-here

# OpenAI Models
OPENAI_API_KEY=your-api-key-here

# Anthropic Models
ANTHROPIC_API_KEY=your-api-key-here

# Custom / Other Provider (if API Key is required)
API_KEY=your-api-key-here
