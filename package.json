{
  "name": "teammedagents-paperclip",
  "version": "0.0.1",
  "description": "TeamMedAgents adapter and core for Paperclip orchestration",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:cli": "tsx packages/core/examples/cli.ts",
    "test:cli:open": "tsx packages/core/examples/cli-open-ended.ts",
    "test:cli:finance": "tsx packages/core/examples/cli-finance.ts",
    "test:cli:legal": "tsx packages/core/examples/cli-legal.ts",
    "test:cli:creative": "tsx packages/core/examples/cli-creative.ts",
    "dev": "pnpm -r --parallel dev"
  },
  "workspaces": [
    "packages/core",
    "packages/adapter",
    "packages/plugin"
  ],
  "devDependencies": {
    "dotenv": "^17.4.2",
    "tsx": "^4.21.0"
  }
}
